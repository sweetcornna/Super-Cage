# Super Cage release configuration for scripts/release/release.sh.
# Copy to ~/.config/super-cage/release.env and run chmod 600 on it (the driver refuses
# a file others can read). Values already set in the environment take precedence.
# No passwords here: name the files that hold them.

# macOS: the Developer ID Application identity in your keychain
# (security find-identity -v -p codesigning). The team id in parentheses is
# also what the DMG checks expect.
CAGE_SIGNING_IDENTITY="Developer ID Application: Example Name (ABCDE12345)"

# Notarization with an App Store Connect API key; nothing is stored in a keychain.
CAGE_NOTARY_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
CAGE_NOTARY_KEY_ID=XXXXXXXXXX
CAGE_NOTARY_ISSUER=00000000-0000-0000-0000-000000000000
# Or a notarytool keychain profile instead of the three lines above:
# CAGE_NOTARY_PROFILE=super-cage-notary

# Android: the APK lane runs when CAGE_ANDROID_KEYSTORE is set (mobile/README.md).
ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
JAVA_HOME=/opt/homebrew/opt/openjdk@21
CAGE_ANDROID_KEYSTORE="$HOME/.super-cage-signing/android/super-cage-release.p12"
CAGE_ANDROID_KEY_ALIAS=release
CAGE_ANDROID_PASSWORD_FILE="$HOME/.super-cage-signing/android/keystore-password"
# The release signer's certificate SHA-256; an APK signed by any other key stops the release.
CAGE_ANDROID_CERT_SHA256=e15628d8854a6cdb79d2ed506b3a015bf0c255483ec26b16f3e2c05fa3b77eb5

# Optional:
# CAGE_RELEASE_REPO=owner/name          GitHub repository (default: the origin remote)
# CAGE_RELEASE_WORK=/path               work folder (default: <main checkout>/.claude/worktrees)
# CAGE_GH_TIMEOUT_MINUTES=90            how long build waits for the GitHub workflow
