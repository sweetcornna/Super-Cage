    {
      "id": "codex",
      "name": "Codex",
      "vendor": "OpenAI",
      "summary_zh": "OpenAI 的终端编程客户端。",
      "with_environment": false,
      "person_only": false,
      "kind": "terminal",
      "session": "existing:codex",
      "status": "hidden",
      "version": "0.171.0",
      "libc": "any",
      "artifacts": {
        "arm64": {
          "format": "tar.gz",
          "url": "https://github.com/openai/codex/releases/download/rust-v0.171.0/codex-aarch64-unknown-linux-musl.tar.gz",
          "sha256": "bcf50b836385e51bd2976ab2bbe92b1b08a1cbe37712eb8dbe378aa78d24871c",
          "size": 124436451,
          "unpacked": 309207448,
          "entry": "codex-aarch64-unknown-linux-musl"
        },
        "amd64": {
          "format": "tar.gz",
          "url": "https://github.com/openai/codex/releases/download/rust-v0.171.0/codex-x86_64-unknown-linux-musl.tar.gz",
          "sha256": "01baa2e47809f8597be5b2f8abd4e4dfe3fb5bcb6e504c2fbaaad97056c15e8d",
          "size": 122664925,
          "unpacked": 315109048,
          "entry": "codex-x86_64-unknown-linux-musl"
        }
      },
      "requires": {
        "packages": [
          "bubblewrap"
        ],
        "userns": true,
        "keyring": false,
        "display": false
      },
      "settings": [
        {
          "file": "/etc/codex/config.toml",
          "format": "toml",
          "set": {
            "check_for_update_on_startup": false,
            "analytics.enabled": false,
            "feedback.enabled": false
          }
        }
      ],
      "updater": {
        "self_update": true,
        "off_by": "setting",
        "note_zh": "启动时的更新检查已关闭；安装目录归 root 所有，客户端无法自行替换。"
      },
      "telemetry": {
        "default_off": true,
        "how": "[analytics] enabled = false and [feedback] enabled = false in /etc/codex/config.toml",
        "note_zh": "已默认关闭使用数据上报。"
      },
      "hosts": {
        "install": [
          "github.com",
          "release-assets.githubusercontent.com",
          "objects.githubusercontent.com"
        ],
        "signin": [
          "chatgpt.com"
        ],
        "run": [
          "chatgpt.com",
          "api.openai.com"
        ],
        "telemetry": []
      },
      "signin": {
        "methods": [
          "device-code",
          "api-key"
        ],
        "login_link_hosts": []
      },
      "data_dirs": [
        {
          "path": "~/.codex",
          "shared": false
        },
        {
          "path": "~/.local/share/cage/codex-accounts",
          "shared": false
        },
        {
          "path": "~/.local/share/cage/codex-sessions",
          "shared": false
        }
      ],
      "project_files": [
        ".codex/config.toml",
        ".codex/hooks.json"
      ],
      "launch": {
        "command": "codex",
        "argv": [
          "/usr/local/bin/codex"
        ],
        "cwd": "project",
        "title": "Codex"
      },
      "mark": {
        "builtin": "codex"
      },
      "regions": {
        "unavailable": [
          "CN",
          "HK"
        ],
        "note_zh": "OpenAI 暂不向中国大陆和香港提供服务；登录取决于所选代理的出口地区。"
      },
      "measured": null,
      "review": {
        "by": "agent-clients step 1.1",
        "date": "2026-11-22",
        "sources": [
          {
            "url": "https://api.github.com/repos/openai/codex/releases/latest",
            "read": "2026-11-22"
          },
          {
            "url": "https://github.com/openai/codex/releases/download/rust-v0.171.0/codex-package_SHA256SUMS",
            "read": "2026-11-22"
          },
          {
            "url": "https://developers.openai.com/api/docs/supported-countries",
            "read": "2026-11-22"
          }
        ],
        "notes": [
          "Pin: release rust-v0.171.0 (published 2026-11-20, not a prerelease). Vendor checksum: the release API per-asset digest (sha256, computed by GitHub at upload), matched by the sha256 of each tarball downloaded on 2026-11-22 over one network. codex-package_SHA256SUMS does not list the plain CLI tarballs pinned here. The codex-<target>.sigstore bundles were not verified.",
          "Each tarball holds one member, the static musl binary named after its target (mode 0755); the download URL redirects to release-assets.githubusercontent.com.",
          "Regions checked 2026-11-22: the supported-countries list (platform.openai.com/docs/supported-countries redirects to the URL in sources) names Taiwan but not mainland China or Hong Kong.",
          "Everything else (settings keys, the bubblewrap requirement, person_only, sign-in and run hosts, project files) comes from unreviewed research notes and Cage's own code (internal/cage/codex-account.py, internal/guard/guard.go); hosts.telemetry is empty because the vendor docs name no telemetry host.",
          "Hidden until step 1.8 (real guest): that Codex reads /etc/codex/config.toml, uses the system bubblewrap, and its idle CPU, RSS and disk."
        ]
      }
    },
    {
      "id": "antigravity-cli",
