{
  "backstop": [
    "--proxy-server=http://127.0.0.1:9",
    "--proxy-bypass-list=\u003c-loopback\u003e;localhost;127.0.0.1;[::1];*.localhost",
    "--webrtc-ip-handling-policy=disable_non_proxied_udp",
    "--disable-shared-workers",
    "--no-pings"
  ],
  "clear_origin": [
    {
      "method": "Storage.clearDataForStorageKey",
      "params": {
        "storageKey": "ORIGIN/^0SITE",
        "storageTypes": "all"
      }
    },
    {
      "method": "Storage.clearDataForOrigin",
      "params": {
        "origin": "ORIGIN",
        "storageTypes": "all"
      }
    }
  ],
  "contract": 2,
  "control": {
    "port": 17777,
    "token": "",
    "pid": 0,
    "controller": {
      "version": "",
      "build": "",
      "protocol": 0,
      "pid": 0
    },
    "science_port": 17840,
    "science_identity": {
      "timezone": "Asia/Tokyo",
      "locale": "ja-JP",
      "language": "ja-JP",
      "languages": [
        "ja-JP"
      ],
      "accept_language": "ja-JP",
      "upstream_accept_language": "ja-JP,ja;q=0.9",
      "user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36",
      "platform": "Linux x86_64",
      "ua_metadata": {
        "brands": [
          {
            "brand": "Chromium",
            "version": "157"
          }
        ],
        "fullVersionList": [],
        "platform": "Linux",
        "platformVersion": "",
        "architecture": "x86",
        "model": "",
        "mobile": false,
        "bitness": "64"
      }
    }
  },
  "crash_wait_ms": 1500,
  "end_wait_ms": 2500,
  "frame": [
    {
      "method": "Emulation.setTimezoneOverride",
      "params": {
        "timezoneId": "Asia/Tokyo"
      }
    },
    {
      "method": "Emulation.setLocaleOverride",
      "params": {
        "locale": "ja-JP"
      }
    },
    {
      "method": "Emulation.setUserAgentOverride",
      "params": {
        "acceptLanguage": "ja-JP",
        "platform": "Linux x86_64",
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36",
        "userAgentMetadata": {
          "brands": [
            {
              "brand": "Chromium",
              "version": "157"
            }
          ],
          "fullVersionList": [],
          "platform": "Linux",
          "platformVersion": "",
          "architecture": "x86",
          "model": "",
          "mobile": false,
          "bitness": "64"
        }
      }
    },
    {
      "method": "Page.enable",
      "params": {}
    },
    {
      "method": "Page.setInterceptFileChooserDialog",
      "params": {
        "cancel": true,
        "enabled": true
      }
    },
    {
      "method": "Target.setAutoAttach",
      "params": {
        "autoAttach": true,
        "flatten": true,
        "waitForDebuggerOnStart": true
      }
    },
    {
      "method": "Runtime.runIfWaitingForDebugger",
      "params": {}
    }
  ],
  "navigate_wait_ms": 5000,
  "page_attach": [
    {
      "method": "Target.setAutoAttach",
      "params": {
        "autoAttach": true,
        "flatten": true,
        "waitForDebuggerOnStart": true
      }
    }
  ],
  "page_detach": [
    {
      "method": "Target.setAutoAttach",
      "params": {
        "autoAttach": false,
        "flatten": true,
        "waitForDebuggerOnStart": false
      }
    }
  ],
  "preferences": {
    "net": {
      "network_prediction_options": 2
    }
  },
  "proxy_check": {
    "loopback_url": "http://127.0.0.3:8099/NONCE",
    "options": {
      "disableCache": true,
      "includeCredentials": false
    },
    "url": "http://cage-proxy-check.invalid/NONCE",
    "verified": "net::ERR_PROXY_CONNECTION_FAILED"
  },
  "resume": [
    {
      "method": "Runtime.runIfWaitingForDebugger",
      "params": {}
    }
  ],
